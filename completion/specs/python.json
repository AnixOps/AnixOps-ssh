{
  "$schema": "../schema/spec.schema.json",
  "name": [
    "python",
    "python3"
  ],
  "description": "Python interpreter",
  "parser": {
    "optionsAfterArgs": false
  },
  "options": [
    {
      "name": "-c",
      "description": "Run a program given as a string",
      "args": [
        {
          "name": "command"
        }
      ]
    },
    {
      "name": "-m",
      "description": "Run a library module as a script",
      "args": [
        {
          "name": "module",
          "suggestions": [
            "venv",
            "pip",
            "http.server",
            "json.tool",
            "unittest",
            "timeit",
            "ensurepip",
            "site",
            "zipfile",
            "tarfile",
            "pdb"
          ]
        }
      ]
    },
    {
      "name": "-i",
      "description": "Inspect interactively after running a script"
    },
    {
      "name": "-u",
      "description": "Do not buffer standard output and error"
    },
    {
      "name": "-v",
      "description": "Trace imports"
    },
    {
      "name": [
        "-V",
        "--version"
      ],
      "description": "Print the version and exit"
    },
    {
      "name": "-O",
      "description": "Remove assert statements"
    },
    {
      "name": "-B",
      "description": "Do not write .pyc files"
    },
    {
      "name": "-E",
      "description": "Ignore PYTHON* environment variables"
    },
    {
      "name": "-s",
      "description": "Do not add the user site directory to sys.path"
    },
    {
      "name": "-S",
      "description": "Do not import the site module"
    },
    {
      "name": "-q",
      "description": "Do not print the version in interactive mode"
    },
    {
      "name": "-W",
      "description": "Warning control",
      "args": [
        {
          "name": "arg",
          "suggestions": [
            "ignore",
            "error",
            "default",
            "always"
          ]
        }
      ]
    },
    {
      "name": "-X",
      "description": "Set an implementation-specific option",
      "args": [
        {
          "name": "option",
          "suggestions": [
            "dev",
            "utf8",
            "importtime"
          ]
        }
      ]
    },
    {
      "name": "-b",
      "description": "Warn about comparing bytes and str"
    },
    {
      "name": [
        "-h",
        "--help"
      ],
      "description": "Print help and exit"
    }
  ],
  "args": [
    {
      "name": "script",
      "optional": true,
      "template": "filepaths"
    },
    {
      "name": "args",
      "description": "Arguments for the script",
      "optional": true,
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
