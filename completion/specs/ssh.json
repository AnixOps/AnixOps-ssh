{
  "$schema": "../schema/spec.schema.json",
  "name": "ssh",
  "description": "Connect to a remote host over SSH",
  "options": [
    {
      "name": "-p",
      "description": "Port to connect to",
      "args": [
        {
          "name": "port"
        }
      ]
    },
    {
      "name": "-i",
      "description": "Identity (private key) file",
      "args": [
        {
          "name": "identity_file",
          "template": "filepaths"
        }
      ],
      "repeatable": true
    },
    {
      "name": "-l",
      "description": "User to log in as",
      "args": [
        {
          "name": "login_name"
        }
      ]
    },
    {
      "name": "-L",
      "description": "Forward a local port to a remote address",
      "args": [
        {
          "name": "[bind_address:]port:host:hostport"
        }
      ],
      "repeatable": true
    },
    {
      "name": "-R",
      "description": "Forward a remote port to a local address",
      "args": [
        {
          "name": "[bind_address:]port:host:hostport"
        }
      ],
      "repeatable": true
    },
    {
      "name": "-D",
      "description": "Open a dynamic SOCKS proxy",
      "args": [
        {
          "name": "[bind_address:]port"
        }
      ],
      "repeatable": true
    },
    {
      "name": "-J",
      "description": "Connect through a jump host",
      "args": [
        {
          "name": "destination",
          "template": "hosts"
        }
      ]
    },
    {
      "name": "-o",
      "description": "Set a configuration option",
      "args": [
        {
          "name": "option",
          "suggestions": [
            "StrictHostKeyChecking=accept-new",
            "ServerAliveInterval=30",
            "UserKnownHostsFile=/dev/null",
            "IdentitiesOnly=yes",
            "BatchMode=yes",
            "ConnectTimeout=10",
            "ForwardAgent=yes",
            "Compression=yes",
            "ProxyJump="
          ]
        }
      ],
      "repeatable": true
    },
    {
      "name": "-F",
      "description": "Use this configuration file",
      "args": [
        {
          "name": "configfile",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "-N",
      "description": "Do not run a remote command"
    },
    {
      "name": "-f",
      "description": "Go to the background before running the command"
    },
    {
      "name": "-T",
      "description": "Do not allocate a terminal"
    },
    {
      "name": "-t",
      "description": "Force allocation of a terminal"
    },
    {
      "name": "-v",
      "description": "Verbose output"
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "-A",
      "description": "Forward the authentication agent"
    },
    {
      "name": "-a",
      "description": "Do not forward the authentication agent"
    },
    {
      "name": "-X",
      "description": "Enable X11 forwarding"
    },
    {
      "name": "-Y",
      "description": "Enable trusted X11 forwarding"
    },
    {
      "name": "-C",
      "description": "Compress all data"
    },
    {
      "name": "-4",
      "description": "Use IPv4 only",
      "exclusiveWith": [
        "-6"
      ]
    },
    {
      "name": "-6",
      "description": "Use IPv6 only",
      "exclusiveWith": [
        "-4"
      ]
    },
    {
      "name": "-g",
      "description": "Allow remote hosts to use forwarded local ports"
    },
    {
      "name": "-W",
      "description": "Forward standard input and output to host:port",
      "args": [
        {
          "name": "host:port"
        }
      ]
    },
    {
      "name": "-S",
      "description": "Control socket path",
      "args": [
        {
          "name": "ctl_path",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "-E",
      "description": "Append debug logs to a file",
      "args": [
        {
          "name": "log_file",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "-G",
      "description": "Print the configuration for the host and exit"
    }
  ],
  "args": [
    {
      "name": "destination",
      "description": "Host to connect to",
      "template": "hosts"
    },
    {
      "name": "command",
      "description": "Command to run on the remote host",
      "optional": true,
      "variadic": true,
      "template": "command"
    }
  ]
}
