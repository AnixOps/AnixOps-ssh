{
  "$schema": "../schema/spec.schema.json",
  "name": "ip",
  "description": "Show and manipulate routing, devices and tunnels",
  "parser": {
    "flagClustering": false
  },
  "options": [
    {
      "name": "-4",
      "description": "Use IPv4 only",
      "exclusiveWith": [
        "-6"
      ]
    },
    {
      "name": "-6",
      "description": "Use IPv6 only",
      "exclusiveWith": [
        "-4"
      ]
    },
    {
      "name": [
        "-s",
        "-stats",
        "-statistics"
      ],
      "description": "Output more statistics"
    },
    {
      "name": [
        "-c",
        "-color"
      ],
      "description": "Colorize the output"
    },
    {
      "name": [
        "-br",
        "-brief"
      ],
      "description": "Print a brief, tabular output"
    },
    {
      "name": [
        "-j",
        "-json"
      ],
      "description": "Output JSON"
    },
    {
      "name": [
        "-p",
        "-pretty"
      ],
      "description": "Make JSON output readable"
    },
    {
      "name": [
        "-o",
        "-oneline"
      ],
      "description": "Output each record on a single line"
    },
    {
      "name": [
        "-d",
        "-details"
      ],
      "description": "Output more detailed information"
    }
  ],
  "subcommands": [
    {
      "name": [
        "address",
        "addr",
        "a"
      ],
      "description": "Show and change protocol addresses",
      "subcommands": [
        {
          "name": [
            "show",
            "list"
          ],
          "description": "Show addresses",
          "args": [
            {
              "name": "filter",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev",
                "up",
                "type",
                "scope"
              ]
            }
          ]
        },
        {
          "name": "add",
          "description": "Add an address",
          "args": [
            {
              "name": "address"
            },
            {
              "name": "options",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev"
              ]
            }
          ]
        },
        {
          "name": [
            "del",
            "delete"
          ],
          "description": "Delete an address",
          "args": [
            {
              "name": "address"
            },
            {
              "name": "options",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev"
              ]
            }
          ]
        },
        {
          "name": "flush",
          "description": "Remove addresses matching the selector",
          "args": [
            {
              "name": "options",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": [
        "link",
        "l"
      ],
      "description": "Show and change network devices",
      "subcommands": [
        {
          "name": [
            "show",
            "list"
          ],
          "description": "Show devices",
          "args": [
            {
              "name": "filter",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev",
                "up",
                "type",
                "scope"
              ]
            }
          ]
        },
        {
          "name": "set",
          "description": "Change device attributes",
          "args": [
            {
              "name": "options",
              "variadic": true,
              "suggestions": [
                "dev",
                "up",
                "down",
                "mtu",
                "name"
              ]
            }
          ]
        },
        {
          "name": "add",
          "description": "Add a virtual device",
          "args": [
            {
              "name": "options",
              "variadic": true,
              "suggestions": [
                "name",
                "type"
              ]
            }
          ]
        },
        {
          "name": [
            "delete",
            "del"
          ],
          "description": "Delete a virtual device",
          "args": [
            {
              "name": "options",
              "variadic": true,
              "suggestions": [
                "dev"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": [
        "route",
        "r"
      ],
      "description": "Show and change the routing table",
      "subcommands": [
        {
          "name": [
            "show",
            "list"
          ],
          "description": "Show routes",
          "args": [
            {
              "name": "filter",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev",
                "up",
                "type",
                "scope"
              ]
            }
          ]
        },
        {
          "name": "add",
          "description": "Add a route",
          "args": [
            {
              "name": "route",
              "variadic": true,
              "suggestions": [
                "default",
                "via",
                "dev"
              ]
            }
          ]
        },
        {
          "name": [
            "del",
            "delete"
          ],
          "description": "Delete a route",
          "args": [
            {
              "name": "route",
              "variadic": true,
              "suggestions": [
                "default",
                "via",
                "dev"
              ]
            }
          ]
        },
        {
          "name": "replace",
          "description": "Add or change a route",
          "args": [
            {
              "name": "route",
              "variadic": true,
              "suggestions": [
                "default",
                "via",
                "dev"
              ]
            }
          ]
        },
        {
          "name": "get",
          "description": "Get a single route",
          "args": [
            {
              "name": "address"
            }
          ]
        },
        {
          "name": "flush",
          "description": "Remove routes matching the selector",
          "args": [
            {
              "name": "options",
              "optional": true,
              "variadic": true
            }
          ]
        }
      ]
    },
    {
      "name": [
        "neighbour",
        "neigh",
        "n"
      ],
      "description": "Show and change neighbour (ARP) entries",
      "subcommands": [
        {
          "name": [
            "show",
            "list"
          ],
          "description": "Show neighbours",
          "args": [
            {
              "name": "filter",
              "optional": true,
              "variadic": true,
              "suggestions": [
                "dev",
                "up",
                "type",
                "scope"
              ]
            }
          ]
        },
        {
          "name": "add",
          "description": "Add a neighbour entry",
          "args": [
            {
              "name": "options",
              "variadic": true,
              "suggestions": [
                "lladdr",
                "dev"
              ]
            }
          ]
        },
        {
          "name": [
            "del",
            "delete"
          ],
          "description": "Delete a neighbour entry",
          "args": [
            {
              "name": "options",
              "variadic": true,
              "suggestions": [
                "dev"
              ]
            }
          ]
        },
        {
          "name": "flush",
          "description": "Flush neighbour entries",
          "args": [
            {
              "name": "options",
              "optional": true,
              "variadic": true
            }
          ]
        }
      ]
    },
    {
      "name": "rule",
      "description": "Show and change routing policy rules",
      "subcommands": [
        {
          "name": [
            "show",
            "list"
          ],
          "description": "Show rules"
        },
        {
          "name": "add",
          "description": "Add a rule",
          "args": [
            {
              "name": "options",
              "variadic": true
            }
          ]
        },
        {
          "name": [
            "del",
            "delete"
          ],
          "description": "Delete a rule",
          "args": [
            {
              "name": "options",
              "variadic": true
            }
          ]
        }
      ]
    },
    {
      "name": "netns",
      "description": "Manage network namespaces",
      "subcommands": [
        {
          "name": [
            "list",
            "show"
          ],
          "description": "List network namespaces"
        },
        {
          "name": "add",
          "description": "Create a network namespace",
          "args": [
            {
              "name": "name"
            }
          ]
        },
        {
          "name": [
            "delete",
            "del"
          ],
          "description": "Delete a network namespace",
          "args": [
            {
              "name": "name"
            }
          ]
        },
        {
          "name": "exec",
          "description": "Run a command in a network namespace",
          "parser": {
            "optionsAfterArgs": false
          },
          "args": [
            {
              "name": "name"
            },
            {
              "name": "command",
              "variadic": true,
              "template": "command"
            }
          ]
        }
      ]
    },
    {
      "name": "monitor",
      "description": "Watch for netlink messages"
    }
  ]
}
