{
  "$schema": "../schema/spec.schema.json",
  "name": "nano",
  "description": "Small and friendly text editor",
  "options": [
    {
      "name": [
        "-B",
        "--backup"
      ],
      "description": "Back up existing files when saving"
    },
    {
      "name": [
        "-c",
        "--constantshow"
      ],
      "description": "Show the cursor position all the time"
    },
    {
      "name": [
        "-i",
        "--autoindent"
      ],
      "description": "Indent new lines like the previous one"
    },
    {
      "name": [
        "-l",
        "--linenumbers"
      ],
      "description": "Show line numbers"
    },
    {
      "name": [
        "-m",
        "--mouse"
      ],
      "description": "Enable mouse support"
    },
    {
      "name": [
        "-v",
        "--view"
      ],
      "description": "View mode (read-only)"
    },
    {
      "name": [
        "-w",
        "--nowrap"
      ],
      "description": "Do not hard-wrap long lines"
    },
    {
      "name": [
        "-E",
        "--tabstospaces"
      ],
      "description": "Convert typed tabs to spaces"
    },
    {
      "name": [
        "-T",
        "--tabsize"
      ],
      "description": "Set the tab width",
      "args": [
        {
          "name": "columns"
        }
      ]
    },
    {
      "name": [
        "-L",
        "--nonewlines"
      ],
      "description": "Do not add a trailing newline"
    },
    {
      "name": [
        "-R",
        "--restricted"
      ],
      "description": "Restricted mode"
    },
    {
      "name": [
        "-S",
        "--softwrap"
      ],
      "description": "Display overlong lines on multiple rows"
    },
    {
      "name": [
        "-x",
        "--nohelp"
      ],
      "description": "Hide the help lines"
    },
    {
      "name": [
        "-V",
        "--version"
      ],
      "description": "Print the version and exit"
    },
    {
      "name": [
        "-h",
        "--help"
      ],
      "description": "Print help and exit"
    }
  ],
  "args": [
    {
      "name": "file",
      "optional": true,
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
