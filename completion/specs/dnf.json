{
  "$schema": "../schema/spec.schema.json",
  "name": [
    "dnf",
    "yum"
  ],
  "description": "Package manager for Fedora, RHEL and derivatives",
  "options": [
    {
      "name": [
        "-y",
        "--assumeyes"
      ],
      "description": "Answer yes to all questions"
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Print less output"
    },
    {
      "name": "--nogpgcheck",
      "description": "Skip GPG signature checks"
    },
    {
      "name": "--enablerepo",
      "description": "Enable a repository for this command",
      "args": [
        {
          "name": "repo"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--disablerepo",
      "description": "Disable a repository for this command",
      "args": [
        {
          "name": "repo"
        }
      ],
      "repeatable": true
    },
    {
      "name": [
        "-x",
        "--exclude"
      ],
      "description": "Exclude packages by name",
      "args": [
        {
          "name": "package"
        }
      ],
      "repeatable": true
    },
    {
      "name": [
        "-C",
        "--cacheonly"
      ],
      "description": "Work from the cache only"
    },
    {
      "name": [
        "-v",
        "--verbose"
      ],
      "description": "Verbose output"
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "reinstall",
      "description": "Reinstall packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "downgrade",
      "description": "Downgrade packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "autoremove",
      "description": "Remove unneeded dependencies"
    },
    {
      "name": "search",
      "description": "Search package names and summaries",
      "args": [
        {
          "name": "keyword",
          "variadic": true
        }
      ]
    },
    {
      "name": "info",
      "description": "Show package details",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "list",
      "description": "List packages",
      "args": [
        {
          "name": "pattern",
          "optional": true,
          "variadic": true,
          "suggestions": [
            "installed",
            "available",
            "updates"
          ]
        }
      ]
    },
    {
      "name": "check-update",
      "description": "Check for available updates"
    },
    {
      "name": "makecache",
      "description": "Download and cache repository metadata"
    },
    {
      "name": "clean",
      "description": "Remove cached data",
      "args": [
        {
          "name": "type",
          "suggestions": [
            "all",
            "packages",
            "metadata",
            "dbcache"
          ]
        }
      ]
    },
    {
      "name": "history",
      "description": "Show or undo transactions",
      "args": [
        {
          "name": "subcommand",
          "optional": true,
          "suggestions": [
            "list",
            "info",
            "undo",
            "redo"
          ]
        }
      ]
    },
    {
      "name": "repolist",
      "description": "List configured repositories"
    },
    {
      "name": "provides",
      "description": "Find which package provides a file",
      "args": [
        {
          "name": "file"
        }
      ]
    }
  ]
}
