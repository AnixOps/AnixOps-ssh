{
  "$schema": "../schema/spec.schema.json",
  "name": "journalctl",
  "description": "Query the systemd journal",
  "options": [
    {
      "name": [
        "-u",
        "--unit"
      ],
      "description": "Show logs of this unit",
      "args": [
        {
          "name": "unit",
          "template": "history"
        }
      ],
      "repeatable": true
    },
    {
      "name": [
        "-f",
        "--follow"
      ],
      "description": "Follow new entries"
    },
    {
      "name": [
        "-n",
        "--lines"
      ],
      "description": "Show this many recent entries",
      "args": [
        {
          "name": "lines",
          "suggestions": [
            "50",
            "100",
            "all"
          ]
        }
      ]
    },
    {
      "name": [
        "-e",
        "--pager-end"
      ],
      "description": "Jump to the end in the pager"
    },
    {
      "name": [
        "-r",
        "--reverse"
      ],
      "description": "Show the newest entries first"
    },
    {
      "name": [
        "-b",
        "--boot"
      ],
      "description": "Show logs of a boot (0 is the current one)",
      "args": [
        {
          "name": "id",
          "optional": true
        }
      ]
    },
    {
      "name": [
        "-k",
        "--dmesg"
      ],
      "description": "Show kernel messages of the current boot"
    },
    {
      "name": [
        "-p",
        "--priority"
      ],
      "description": "Filter by priority",
      "args": [
        {
          "name": "priority",
          "suggestions": [
            "emerg",
            "alert",
            "crit",
            "err",
            "warning",
            "notice",
            "info",
            "debug"
          ]
        }
      ]
    },
    {
      "name": [
        "-S",
        "--since"
      ],
      "description": "Show entries since a date",
      "args": [
        {
          "name": "date",
          "suggestions": [
            "today",
            "yesterday",
            "1 hour ago"
          ]
        }
      ]
    },
    {
      "name": [
        "-U",
        "--until"
      ],
      "description": "Show entries until a date",
      "args": [
        {
          "name": "date",
          "suggestions": [
            "now",
            "yesterday",
            "1 hour ago"
          ]
        }
      ]
    },
    {
      "name": [
        "-o",
        "--output"
      ],
      "description": "Output format",
      "args": [
        {
          "name": "format",
          "suggestions": [
            "short",
            "short-iso",
            "verbose",
            "json",
            "json-pretty",
            "cat"
          ]
        }
      ]
    },
    {
      "name": [
        "-x",
        "--catalog"
      ],
      "description": "Add explanations from the message catalog"
    },
    {
      "name": "--no-pager",
      "description": "Do not pipe output into a pager"
    },
    {
      "name": [
        "-g",
        "--grep"
      ],
      "description": "Show entries whose message matches a pattern",
      "args": [
        {
          "name": "pattern"
        }
      ]
    },
    {
      "name": "--user",
      "description": "Show the current user's journal"
    },
    {
      "name": "--system",
      "description": "Show the system journal"
    },
    {
      "name": [
        "-t",
        "--identifier"
      ],
      "description": "Show entries with this syslog identifier",
      "args": [
        {
          "name": "identifier"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--disk-usage",
      "description": "Show how much disk space the journal uses"
    },
    {
      "name": "--vacuum-size",
      "description": "Reduce the journal to this size",
      "args": [
        {
          "name": "size"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--vacuum-time",
      "description": "Remove entries older than this",
      "args": [
        {
          "name": "time"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--list-boots",
      "description": "List the boots in the journal"
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Do not show info messages"
    },
    {
      "name": [
        "-a",
        "--all"
      ],
      "description": "Show all fields, including long ones"
    },
    {
      "name": "--utc",
      "description": "Express time in UTC"
    }
  ]
}
