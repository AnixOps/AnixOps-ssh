{
  "$schema": "../schema/spec.schema.json",
  "name": "nginx",
  "description": "HTTP and reverse proxy server",
  "options": [
    {
      "name": "-t",
      "description": "Test the configuration and exit"
    },
    {
      "name": "-T",
      "description": "Test the configuration, dump it and exit"
    },
    {
      "name": "-s",
      "description": "Send a signal to the master process",
      "args": [
        {
          "name": "signal",
          "suggestions": [
            {
              "name": "stop",
              "description": "Fast shutdown"
            },
            {
              "name": "quit",
              "description": "Graceful shutdown"
            },
            {
              "name": "reopen",
              "description": "Reopen the log files"
            },
            {
              "name": "reload",
              "description": "Reload the configuration"
            }
          ]
        }
      ]
    },
    {
      "name": "-c",
      "description": "Use this configuration file",
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": "-p",
      "description": "Set the prefix path",
      "args": [
        {
          "name": "prefix",
          "template": "folders"
        }
      ]
    },
    {
      "name": "-g",
      "description": "Set global configuration directives",
      "args": [
        {
          "name": "directives"
        }
      ]
    },
    {
      "name": "-q",
      "description": "Suppress non-error messages during the test"
    },
    {
      "name": "-v",
      "description": "Print the version and exit"
    },
    {
      "name": "-V",
      "description": "Print the version and build options and exit"
    },
    {
      "name": "-h",
      "description": "Print help and exit"
    }
  ]
}
