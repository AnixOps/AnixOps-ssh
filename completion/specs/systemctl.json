{
  "$schema": "../schema/spec.schema.json",
  "name": "systemctl",
  "description": "Control the systemd system and service manager",
  "options": [
    {
      "name": "--user",
      "description": "Talk to the user service manager",
      "exclusiveWith": [
        "--system"
      ]
    },
    {
      "name": "--system",
      "description": "Talk to the system service manager",
      "exclusiveWith": [
        "--user"
      ]
    },
    {
      "name": [
        "-H",
        "--host"
      ],
      "description": "Operate on a remote host",
      "args": [
        {
          "name": "host",
          "template": "hosts"
        }
      ]
    },
    {
      "name": [
        "-a",
        "--all"
      ],
      "description": "Show all units, including inactive ones"
    },
    {
      "name": [
        "-l",
        "--full"
      ],
      "description": "Do not ellipsize output"
    },
    {
      "name": "--no-pager",
      "description": "Do not pipe output into a pager"
    },
    {
      "name": "--now",
      "description": "Start or stop the unit as well when enabling or disabling"
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Suppress output"
    },
    {
      "name": [
        "-t",
        "--type"
      ],
      "description": "Only units of this type",
      "args": [
        {
          "name": "type",
          "suggestions": [
            "service",
            "socket",
            "timer",
            "mount",
            "target",
            "path"
          ]
        }
      ]
    },
    {
      "name": "--state",
      "description": "Only units in this state",
      "args": [
        {
          "name": "state",
          "suggestions": [
            "active",
            "inactive",
            "failed",
            "running",
            "enabled",
            "disabled"
          ]
        }
      ]
    },
    {
      "name": "--failed",
      "description": "Show only failed units"
    },
    {
      "name": [
        "-f",
        "--force"
      ],
      "description": "Overwrite existing links when enabling"
    },
    {
      "name": "--no-block",
      "description": "Do not wait until the operation finishes"
    },
    {
      "name": [
        "-n",
        "--lines"
      ],
      "description": "Number of journal lines to show in status",
      "args": [
        {
          "name": "lines"
        }
      ]
    }
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "restart",
      "description": "Restart units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "try-restart",
      "description": "Restart units if they are running",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "reload",
      "description": "Reload units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "reload-or-restart",
      "description": "Reload units, or restart them if they cannot reload",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "status",
      "description": "Show the status of units",
      "args": [
        {
          "name": "unit",
          "description": "Unit names",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "enable",
      "description": "Enable units to start at boot",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "disable",
      "description": "Disable units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "mask",
      "description": "Mask units so they cannot be started",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "unmask",
      "description": "Unmask units",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "is-active",
      "description": "Check whether units are active",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "is-enabled",
      "description": "Check whether units are enabled",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "is-failed",
      "description": "Check whether units are failed",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "cat",
      "description": "Show the unit files",
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "show",
      "description": "Show properties of units",
      "options": [
        {
          "name": [
            "-p",
            "--property"
          ],
          "description": "Show only this property",
          "args": [
            {
              "name": "property"
            }
          ],
          "repeatable": true
        }
      ],
      "args": [
        {
          "name": "unit",
          "description": "Unit names",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "edit",
      "description": "Edit a unit file or drop-in",
      "options": [
        {
          "name": "--full",
          "description": "Edit the whole unit file"
        },
        {
          "name": "--runtime",
          "description": "Make the change temporary"
        }
      ],
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "kill",
      "description": "Send a signal to the processes of units",
      "options": [
        {
          "name": [
            "-s",
            "--signal"
          ],
          "description": "Signal to send",
          "args": [
            {
              "name": "signal"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "unit",
          "description": "Unit name",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "reset-failed",
      "description": "Reset the failed state of units",
      "args": [
        {
          "name": "unit",
          "description": "Unit names",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "list-dependencies",
      "description": "Show the dependencies of a unit",
      "args": [
        {
          "name": "unit",
          "description": "Unit names",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "list-units",
      "description": "List loaded units",
      "args": [
        {
          "name": "pattern",
          "optional": true
        }
      ]
    },
    {
      "name": "list-unit-files",
      "description": "List installed unit files",
      "args": [
        {
          "name": "pattern",
          "optional": true
        }
      ]
    },
    {
      "name": "list-timers",
      "description": "List timer units"
    },
    {
      "name": "list-sockets",
      "description": "List socket units"
    },
    {
      "name": "daemon-reload",
      "description": "Reload the systemd manager configuration"
    },
    {
      "name": "daemon-reexec",
      "description": "Re-execute the systemd manager"
    },
    {
      "name": "poweroff",
      "description": "Shut down and power off the system"
    },
    {
      "name": "reboot",
      "description": "Shut down and reboot the system"
    }
  ]
}
