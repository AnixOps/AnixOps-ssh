{
  "$schema": "../schema/spec.schema.json",
  "name": "ls",
  "description": "List directory contents",
  "options": [
    {
      "name": [
        "-a",
        "--all"
      ],
      "description": "Show hidden entries"
    },
    {
      "name": [
        "-A",
        "--almost-all"
      ],
      "description": "Show hidden entries except . and .."
    },
    {
      "name": "-l",
      "description": "Use the long listing format"
    },
    {
      "name": [
        "-h",
        "--human-readable"
      ],
      "description": "Print sizes in human readable units"
    },
    {
      "name": [
        "-R",
        "--recursive"
      ],
      "description": "List subdirectories recursively"
    },
    {
      "name": "-t",
      "description": "Sort by modification time, newest first"
    },
    {
      "name": "-S",
      "description": "Sort by file size, largest first"
    },
    {
      "name": [
        "-r",
        "--reverse"
      ],
      "description": "Reverse the sort order"
    },
    {
      "name": [
        "-d",
        "--directory"
      ],
      "description": "List directories themselves, not their contents"
    },
    {
      "name": "-1",
      "description": "List one entry per line"
    },
    {
      "name": [
        "-F",
        "--classify"
      ],
      "description": "Append an indicator (/, *, @) to entries"
    },
    {
      "name": [
        "-i",
        "--inode"
      ],
      "description": "Print the inode number"
    },
    {
      "name": [
        "-s",
        "--size"
      ],
      "description": "Print the allocated size of each file"
    },
    {
      "name": "--color",
      "description": "Colorize the output",
      "args": [
        {
          "name": "when",
          "optional": true,
          "suggestions": [
            "always",
            "auto",
            "never"
          ]
        }
      ],
      "requiresEquals": true
    }
  ],
  "args": [
    {
      "name": "file",
      "optional": true,
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
