{
  "$schema": "../schema/spec.schema.json",
  "name": "node",
  "description": "JavaScript runtime",
  "parser": {
    "optionsAfterArgs": false
  },
  "options": [
    {
      "name": [
        "-e",
        "--eval"
      ],
      "description": "Evaluate a script",
      "args": [
        {
          "name": "script"
        }
      ]
    },
    {
      "name": [
        "-p",
        "--print"
      ],
      "description": "Evaluate a script and print the result",
      "args": [
        {
          "name": "script"
        }
      ]
    },
    {
      "name": [
        "-r",
        "--require"
      ],
      "description": "Preload a module",
      "args": [
        {
          "name": "module"
        }
      ],
      "repeatable": true
    },
    {
      "name": [
        "-v",
        "--version"
      ],
      "description": "Print the version"
    },
    {
      "name": [
        "-c",
        "--check"
      ],
      "description": "Check the syntax without running"
    },
    {
      "name": [
        "-i",
        "--interactive"
      ],
      "description": "Open the REPL even if standard input is not a terminal"
    },
    {
      "name": "--inspect",
      "description": "Activate the inspector",
      "args": [
        {
          "name": "host:port"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--inspect-brk",
      "description": "Activate the inspector and break at the start",
      "args": [
        {
          "name": "host:port"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--max-old-space-size",
      "description": "Maximum heap size in MB",
      "args": [
        {
          "name": "megabytes"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--watch",
      "description": "Restart when imported files change"
    },
    {
      "name": "--env-file",
      "description": "Load environment variables from a file",
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ],
      "requiresEquals": true
    },
    {
      "name": "--import",
      "description": "Preload an ES module",
      "args": [
        {
          "name": "module"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--test",
      "description": "Run the built-in test runner"
    },
    {
      "name": "--no-warnings",
      "description": "Silence process warnings"
    },
    {
      "name": "--trace-warnings",
      "description": "Print stack traces for warnings"
    },
    {
      "name": [
        "-h",
        "--help"
      ],
      "description": "Print help and exit"
    }
  ],
  "args": [
    {
      "name": "script",
      "optional": true,
      "template": "filepaths"
    },
    {
      "name": "args",
      "description": "Arguments for the script",
      "optional": true,
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
