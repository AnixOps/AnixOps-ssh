{
  "$schema": "../schema/spec.schema.json",
  "name": "apt",
  "description": "Package manager for Debian and Ubuntu",
  "options": [
    {
      "name": [
        "-y",
        "--yes"
      ],
      "description": "Assume yes to all questions"
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Produce less output"
    },
    {
      "name": [
        "-s",
        "--simulate",
        "--dry-run"
      ],
      "description": "Do not make changes, only show what would happen"
    },
    {
      "name": "--no-install-recommends",
      "description": "Do not install recommended packages"
    },
    {
      "name": [
        "-f",
        "--fix-broken"
      ],
      "description": "Try to fix broken dependencies"
    },
    {
      "name": "--reinstall",
      "description": "Reinstall packages that are already installed"
    },
    {
      "name": [
        "-d",
        "--download-only"
      ],
      "description": "Only download packages"
    },
    {
      "name": [
        "-V",
        "--verbose-versions"
      ],
      "description": "Show full versions"
    }
  ],
  "subcommands": [
    {
      "name": "update",
      "description": "Refresh the package lists"
    },
    {
      "name": "upgrade",
      "description": "Upgrade installed packages"
    },
    {
      "name": "full-upgrade",
      "description": "Upgrade packages, removing others if needed"
    },
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "purge",
      "description": "Remove packages and their configuration",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "autoremove",
      "description": "Remove unused dependencies"
    },
    {
      "name": "autoclean",
      "description": "Remove obsolete downloaded packages"
    },
    {
      "name": "clean",
      "description": "Remove all downloaded package files"
    },
    {
      "name": "search",
      "description": "Search the package lists",
      "args": [
        {
          "name": "regex",
          "variadic": true
        }
      ]
    },
    {
      "name": "show",
      "description": "Show package details",
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "policy",
      "description": "Show the installed and candidate versions",
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "list",
      "description": "List packages",
      "options": [
        {
          "name": "--installed",
          "description": "Only installed packages"
        },
        {
          "name": "--upgradable",
          "description": "Only upgradable packages"
        },
        {
          "name": [
            "-a",
            "--all-versions"
          ],
          "description": "Show all versions"
        }
      ],
      "args": [
        {
          "name": "pattern",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "edit-sources",
      "description": "Edit the sources list"
    }
  ]
}
