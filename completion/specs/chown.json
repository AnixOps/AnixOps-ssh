{
  "$schema": "../schema/spec.schema.json",
  "name": "chown",
  "description": "Change file owner and group",
  "options": [
    {
      "name": [
        "-R",
        "--recursive"
      ],
      "description": "Operate on files and directories recursively"
    },
    {
      "name": [
        "-v",
        "--verbose"
      ],
      "description": "Report every file processed"
    },
    {
      "name": [
        "-c",
        "--changes"
      ],
      "description": "Report only when a change is made"
    },
    {
      "name": [
        "-f",
        "--silent",
        "--quiet"
      ],
      "description": "Suppress most error messages"
    },
    {
      "name": [
        "-h",
        "--no-dereference"
      ],
      "description": "Change symbolic links themselves"
    },
    {
      "name": "--reference",
      "description": "Use the owner and group of another file",
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ],
      "requiresEquals": true
    }
  ],
  "args": [
    {
      "name": "owner[:group]",
      "suggestions": [
        "root",
        "root:root"
      ]
    },
    {
      "name": "file",
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
