{
  "$schema": "../schema/spec.schema.json",
  "name": "grep",
  "description": "Search files for lines matching a pattern",
  "options": [
    {
      "name": [
        "-i",
        "--ignore-case"
      ],
      "description": "Ignore case"
    },
    {
      "name": [
        "-v",
        "--invert-match"
      ],
      "description": "Select non-matching lines"
    },
    {
      "name": [
        "-r",
        "--recursive"
      ],
      "description": "Search directories recursively"
    },
    {
      "name": [
        "-R",
        "--dereference-recursive"
      ],
      "description": "Search recursively, following all symlinks"
    },
    {
      "name": [
        "-n",
        "--line-number"
      ],
      "description": "Prefix each line with its line number"
    },
    {
      "name": [
        "-c",
        "--count"
      ],
      "description": "Print only a count of matching lines"
    },
    {
      "name": [
        "-l",
        "--files-with-matches"
      ],
      "description": "Print only names of files with matches"
    },
    {
      "name": [
        "-L",
        "--files-without-match"
      ],
      "description": "Print only names of files without matches"
    },
    {
      "name": [
        "-w",
        "--word-regexp"
      ],
      "description": "Match whole words only"
    },
    {
      "name": [
        "-x",
        "--line-regexp"
      ],
      "description": "Match whole lines only"
    },
    {
      "name": [
        "-E",
        "--extended-regexp"
      ],
      "description": "Use extended regular expressions"
    },
    {
      "name": [
        "-F",
        "--fixed-strings"
      ],
      "description": "Treat the pattern as a fixed string"
    },
    {
      "name": [
        "-P",
        "--perl-regexp"
      ],
      "description": "Use Perl regular expressions"
    },
    {
      "name": [
        "-e",
        "--regexp"
      ],
      "description": "Use this pattern (can be given several times)",
      "args": [
        {
          "name": "pattern"
        }
      ],
      "repeatable": true
    },
    {
      "name": [
        "-f",
        "--file"
      ],
      "description": "Read patterns from a file",
      "args": [
        {
          "name": "file",
          "template": "filepaths"
        }
      ]
    },
    {
      "name": [
        "-o",
        "--only-matching"
      ],
      "description": "Print only the matched parts"
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Print nothing, exit with status 0 on a match"
    },
    {
      "name": [
        "-s",
        "--no-messages"
      ],
      "description": "Suppress file error messages"
    },
    {
      "name": [
        "-h",
        "--no-filename"
      ],
      "description": "Do not print file names"
    },
    {
      "name": [
        "-H",
        "--with-filename"
      ],
      "description": "Print the file name for each match"
    },
    {
      "name": [
        "-A",
        "--after-context"
      ],
      "description": "Print N lines after a match",
      "args": [
        {
          "name": "number"
        }
      ]
    },
    {
      "name": [
        "-B",
        "--before-context"
      ],
      "description": "Print N lines before a match",
      "args": [
        {
          "name": "number"
        }
      ]
    },
    {
      "name": [
        "-C",
        "--context"
      ],
      "description": "Print N lines around a match",
      "args": [
        {
          "name": "number"
        }
      ]
    },
    {
      "name": [
        "-m",
        "--max-count"
      ],
      "description": "Stop after N matching lines",
      "args": [
        {
          "name": "number"
        }
      ]
    },
    {
      "name": [
        "-a",
        "--text"
      ],
      "description": "Treat binary files as text"
    },
    {
      "name": "--include",
      "description": "Search only files matching this glob",
      "args": [
        {
          "name": "glob"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--exclude",
      "description": "Skip files matching this glob",
      "args": [
        {
          "name": "glob"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--exclude-dir",
      "description": "Skip directories matching this glob",
      "args": [
        {
          "name": "glob"
        }
      ],
      "repeatable": true
    },
    {
      "name": "--color",
      "description": "Highlight matches",
      "args": [
        {
          "name": "when",
          "optional": true,
          "suggestions": [
            "always",
            "auto",
            "never"
          ]
        }
      ],
      "requiresEquals": true
    }
  ],
  "args": [
    {
      "name": "pattern"
    },
    {
      "name": "file",
      "optional": true,
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
