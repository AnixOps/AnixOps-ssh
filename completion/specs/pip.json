{
  "$schema": "../schema/spec.schema.json",
  "name": [
    "pip",
    "pip3"
  ],
  "description": "Python package installer",
  "options": [
    {
      "name": [
        "-v",
        "--verbose"
      ],
      "description": "Give more output",
      "persistent": true,
      "repeatable": true
    },
    {
      "name": [
        "-q",
        "--quiet"
      ],
      "description": "Give less output",
      "persistent": true,
      "repeatable": true
    },
    {
      "name": "--proxy",
      "description": "Use this proxy",
      "args": [
        {
          "name": "proxy"
        }
      ],
      "persistent": true
    },
    {
      "name": "--retries",
      "description": "Maximum attempts per connection",
      "args": [
        {
          "name": "retries"
        }
      ],
      "persistent": true
    },
    {
      "name": "--timeout",
      "description": "Socket timeout in seconds",
      "args": [
        {
          "name": "seconds"
        }
      ],
      "persistent": true
    },
    {
      "name": "--cache-dir",
      "description": "Store the cache in this directory",
      "args": [
        {
          "name": "dir",
          "template": "folders"
        }
      ],
      "persistent": true
    },
    {
      "name": "--disable-pip-version-check",
      "description": "Do not check for a new pip version",
      "persistent": true
    },
    {
      "name": "--no-color",
      "description": "Suppress colored output",
      "persistent": true
    },
    {
      "name": "--version",
      "description": "Show the version and exit"
    }
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "options": [
        {
          "name": [
            "-r",
            "--requirement"
          ],
          "description": "Install from a requirements file",
          "args": [
            {
              "name": "file",
              "template": "filepaths"
            }
          ],
          "repeatable": true
        },
        {
          "name": [
            "-U",
            "--upgrade"
          ],
          "description": "Upgrade packages to the newest version"
        },
        {
          "name": [
            "-e",
            "--editable"
          ],
          "description": "Install a project in editable mode",
          "args": [
            {
              "name": "path",
              "template": "filepaths"
            }
          ],
          "repeatable": true
        },
        {
          "name": "--user",
          "description": "Install to the user site"
        },
        {
          "name": "--no-cache-dir",
          "description": "Disable the cache"
        },
        {
          "name": [
            "-t",
            "--target"
          ],
          "description": "Install into this directory",
          "args": [
            {
              "name": "dir",
              "template": "folders"
            }
          ]
        },
        {
          "name": "--pre",
          "description": "Include pre-release versions"
        },
        {
          "name": [
            "-i",
            "--index-url"
          ],
          "description": "Base URL of the package index",
          "args": [
            {
              "name": "url"
            }
          ]
        },
        {
          "name": "--extra-index-url",
          "description": "Extra package index URL",
          "args": [
            {
              "name": "url"
            }
          ],
          "repeatable": true
        },
        {
          "name": "--no-deps",
          "description": "Do not install dependencies"
        },
        {
          "name": "--force-reinstall",
          "description": "Reinstall packages even if up to date"
        },
        {
          "name": [
            "-c",
            "--constraint"
          ],
          "description": "Constrain versions with a file",
          "args": [
            {
              "name": "file",
              "template": "filepaths"
            }
          ],
          "repeatable": true
        },
        {
          "name": "--break-system-packages",
          "description": "Allow modifying an externally managed environment"
        },
        {
          "name": "--no-build-isolation",
          "description": "Disable isolation when building"
        }
      ],
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall packages",
      "options": [
        {
          "name": [
            "-y",
            "--yes"
          ],
          "description": "Do not ask for confirmation"
        },
        {
          "name": [
            "-r",
            "--requirement"
          ],
          "description": "Uninstall all packages in a file",
          "args": [
            {
              "name": "file",
              "template": "filepaths"
            }
          ],
          "repeatable": true
        }
      ],
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": [
            "-o",
            "--outdated"
          ],
          "description": "List outdated packages"
        },
        {
          "name": [
            "-u",
            "--uptodate"
          ],
          "description": "List up-to-date packages"
        },
        {
          "name": "--format",
          "description": "Output format",
          "args": [
            {
              "name": "format",
              "suggestions": [
                "columns",
                "freeze",
                "json"
              ]
            }
          ]
        },
        {
          "name": [
            "-l",
            "--local"
          ],
          "description": "Only packages local to the virtual environment"
        },
        {
          "name": "--user",
          "description": "Only packages in the user site"
        },
        {
          "name": "--not-required",
          "description": "List packages that are not dependencies of others"
        }
      ]
    },
    {
      "name": "freeze",
      "description": "Output installed packages in requirements format",
      "options": [
        {
          "name": [
            "-l",
            "--local"
          ],
          "description": "Only packages local to the virtual environment"
        },
        {
          "name": "--user",
          "description": "Only packages in the user site"
        }
      ]
    },
    {
      "name": "show",
      "description": "Show information about packages",
      "options": [
        {
          "name": [
            "-f",
            "--files"
          ],
          "description": "Show the installed files"
        }
      ],
      "args": [
        {
          "name": "package",
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "check",
      "description": "Verify that installed packages have compatible dependencies"
    },
    {
      "name": "download",
      "description": "Download packages without installing",
      "options": [
        {
          "name": [
            "-d",
            "--dest"
          ],
          "description": "Download into this directory",
          "args": [
            {
              "name": "dir",
              "template": "folders"
            }
          ]
        },
        {
          "name": [
            "-r",
            "--requirement"
          ],
          "description": "Download from a requirements file",
          "args": [
            {
              "name": "file",
              "template": "filepaths"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true,
          "template": "history"
        }
      ]
    },
    {
      "name": "wheel",
      "description": "Build wheels for requirements",
      "options": [
        {
          "name": [
            "-w",
            "--wheel-dir"
          ],
          "description": "Build wheels into this directory",
          "args": [
            {
              "name": "dir",
              "template": "folders"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "package",
          "optional": true,
          "variadic": true
        }
      ]
    },
    {
      "name": "cache",
      "description": "Inspect and manage the cache",
      "subcommands": [
        {
          "name": "dir",
          "description": "Show the cache directory"
        },
        {
          "name": "info",
          "description": "Show cache information"
        },
        {
          "name": "list",
          "description": "List cached wheels"
        },
        {
          "name": "purge",
          "description": "Remove all cached files"
        },
        {
          "name": "remove",
          "description": "Remove cached files matching a pattern",
          "args": [
            {
              "name": "pattern"
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage the configuration",
      "subcommands": [
        {
          "name": "list",
          "description": "List the active configuration"
        },
        {
          "name": "get",
          "description": "Get a value",
          "args": [
            {
              "name": "name"
            }
          ]
        },
        {
          "name": "set",
          "description": "Set a value",
          "args": [
            {
              "name": "name"
            },
            {
              "name": "value"
            }
          ]
        },
        {
          "name": "unset",
          "description": "Unset a value",
          "args": [
            {
              "name": "name"
            }
          ]
        }
      ]
    }
  ]
}
