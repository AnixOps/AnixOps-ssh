{
  "$schema": "../schema/spec.schema.json",
  "name": "cp",
  "description": "Copy files and directories",
  "options": [
    {
      "name": [
        "-r",
        "-R",
        "--recursive"
      ],
      "description": "Copy directories recursively"
    },
    {
      "name": [
        "-a",
        "--archive"
      ],
      "description": "Copy recursively and preserve attributes"
    },
    {
      "name": [
        "-f",
        "--force"
      ],
      "description": "Overwrite destination files without asking"
    },
    {
      "name": [
        "-i",
        "--interactive"
      ],
      "description": "Ask before overwriting"
    },
    {
      "name": [
        "-n",
        "--no-clobber"
      ],
      "description": "Never overwrite an existing file"
    },
    {
      "name": "-p",
      "description": "Preserve mode, ownership and timestamps"
    },
    {
      "name": [
        "-u",
        "--update"
      ],
      "description": "Copy only when the source is newer"
    },
    {
      "name": [
        "-v",
        "--verbose"
      ],
      "description": "Explain what is being done"
    },
    {
      "name": [
        "-t",
        "--target-directory"
      ],
      "description": "Copy all sources into this directory",
      "args": [
        {
          "name": "directory",
          "template": "folders"
        }
      ]
    },
    {
      "name": [
        "-T",
        "--no-target-directory"
      ],
      "description": "Treat the destination as a normal file"
    },
    {
      "name": [
        "-l",
        "--link"
      ],
      "description": "Hard link files instead of copying"
    },
    {
      "name": [
        "-s",
        "--symbolic-link"
      ],
      "description": "Make symbolic links instead of copying"
    },
    {
      "name": [
        "-L",
        "--dereference"
      ],
      "description": "Always follow symbolic links in the source"
    },
    {
      "name": [
        "-P",
        "--no-dereference"
      ],
      "description": "Never follow symbolic links in the source"
    }
  ],
  "args": [
    {
      "name": "source",
      "variadic": true,
      "template": "filepaths"
    }
  ]
}
