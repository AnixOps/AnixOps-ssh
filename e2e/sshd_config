# TEST ONLY.
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key
UsePAM yes
PermitRootLogin no
PrintMotd no
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
# A -R socket left by an earlier run is replaced.
StreamLocalBindUnlink yes
# As Debian's and Ubuntu's default: the client's locale reaches the shell
# (COLORTERM does not, as on most servers).
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server

PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes

# pwuser: password only.
Match User pwuser
    PasswordAuthentication yes
    PubkeyAuthentication no

# keyuser, zshuser, fishuser: public key only.
Match User keyuser,zshuser,fishuser
    PasswordAuthentication no
    PubkeyAuthentication yes
