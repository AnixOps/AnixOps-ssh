{
  "name": "anixops-ssh",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint:colors && npm run lint:workflows && vitest run",
    "lint:colors": "node scripts/check-colors.mjs",
    "lint:workflows": "node scripts/check-workflows.mjs",
    "gen:proto": "json2ts -i crates/easyssh-proto/schema/proto.schema.json -o src/lib/proto.gen.ts --unreachableDefinitions --cwd crates/easyssh-proto/schema",
    "preview": "vite preview --port 4173 --strictPort",
    "screenshots": "node scripts/screenshots.mjs",
    "test:mobile": "node scripts/mobile-e2e.mjs",
    "tauri": "tauri",
    "check:specs": "node scripts/check-specs.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2.0",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@xterm/headless": "^5.5.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.52.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
